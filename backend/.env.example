# Backend environment variables
# Database
# --- Local mode (default, zero setup) ---
USE_LOCAL_DB=True
USE_TURSO_DB=False
LOCAL_DB_PATH=detomsite_local.db
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=detomsite
SEED_DEMO_DATA=False

# --- Supabase mode (production) ---
# Set USE_SUPABASE_DB=True and provide the Postgres connection string from
# Supabase Dashboard -> Project Settings -> Database -> Connection string.
# Then run the schema in supabase/schema.sql via the Supabase SQL Editor.
USE_SUPABASE_DB=False
SUPABASE_DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# ...or use individual settings:
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=
SUPABASE_DB_NAME=postgres

# Optional SECOND Supabase database (dual-read). When set, read-only lookups
# fall back to this database whenever the primary returns nothing, so the app
# can read historical data living in another Supabase project. Writes and
# auto-migrations always stay on the PRIMARY database above.
SUPABASE_SECONDARY_DATABASE_URL=
SUPABASE_SECONDARY_DB_HOST=
SUPABASE_SECONDARY_DB_PORT=5432
SUPABASE_SECONDARY_DB_USER=postgres
SUPABASE_SECONDARY_DB_PASSWORD=
SUPABASE_SECONDARY_DB_NAME=postgres

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=replace-with-long-random-secret
SECRET_KEY=replace-with-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Default Super Admin
DEFAULT_SUPER_ADMIN_EMAIL=12@gmail.com
DEFAULT_SUPER_ADMIN_PASSWORD=8989

# Frontend / Supabase (used by the frontends for optional profile sync)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Cloudinary


# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Sentry
SENTRY_DSN=

# Application
APP_NAME=DETOMSITE
APP_VERSION=3.1.0
DEBUG=True  # True = local development (allows localhost URLs); set False when deploying
HOST=0.0.0.0
PORT=8000
# FRONTEND_URL = your MAIN portal URL (single value). Local dev: localhost OK when DEBUG=True.
# Production: https://your-user-portal.vercel.app
FRONTEND_URL=http://localhost:5173
# BACKEND_URL = your backend API URL. Production: https://your-api.vercel.app
BACKEND_URL=http://localhost:8000

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:3000,https://your-frontend.vercel.app,https://your-backend.vercel.app
