<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#0f766e">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="DETOMSITE Admin"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvGreeting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="13sp"
            android:textColor="#BBF7D0"
            app:layout_constraintTop_toBottomOf="@id/tvTitle" />

        <TextView
            android:id="@+id/tvStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textSize="15sp"
            android:textColor="#FFFFFF"
            app:layout_constraintTop_toBottomOf="@id/tvGreeting" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/swNotif"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:checked="false"
            android:text="Notification ON — ping me on every new order"
            android:textColor="#FFFFFF"
            app:thumbTint="#22C55E"
            app:trackTint="#164E63"
            app:layout_constraintTop_toBottomOf="@id/tvStats" />

        <Button
            android:id="@+id/btnGrantNotif"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:text="Allow notifications"
            android:textSize="14sp"
            app:layout_constraintTop_toBottomOf="@id/swNotif" />

        <TextView
            android:id="@+id/lblOrders"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="RECENT ORDERS"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#6EE7B7"
            app:layout_constraintTop_toBottomOf="@id/btnGrantNotif" />

        <TextView
            android:id="@+id/tvOrders"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="14sp"
            android:textColor="#D1FAE5"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="12dp"
            app:layout_constraintTop_toBottomOf="@id/lblOrders"
            app:layout_constraintBottom_toBottomOf="parent" />

        <Button
            android:id="@+id/btnRefresh"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="14dp"
            android:text="REFRESH"
            android:textSize="14sp"
            app:layout_constraintTop_toBottomOf="@id/tvOrders" />

        <Button
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="Logout"
            android:textSize="14sp"
            app:layout_constraintTop_toBottomOf="@id/btnRefresh"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>