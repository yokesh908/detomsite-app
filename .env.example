# ══════════════════════════════════════════════════════════════
# DETOMSITE — Production environment variables (Supabase + Render)
# ══════════════════════════════════════════════════════════════

# ─── Database → Supabase (free tier: https://supabase.com) ───
# Connection string from Supabase Dashboard → Project Settings → Database.
# Use the "Transaction" pooler URL (port 6543):
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
SUPABASE_DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Or use individual fields:
# SUPABASE_DB_HOST=db.<ref>.supabase.co
# SUPABASE_DB_PORT=5432
# SUPABASE_DB_USER=postgres
# SUPABASE_DB_PASSWORD=your-password
# SUPABASE_DB_NAME=postgres

# ─── Security ───
JWT_SECRET=replace-with-a-long-random-secret

# ─── URLs ───
FRONTEND_URL=https://<your-frontend>.vercel.app
BACKEND_URL=https://<your-backend>.onrender.com
ALLOWED_ORIGINS=https://<your-frontend>.vercel.app,http://localhost:5173

# ─── Admin (NO hardcoded credentials — set these) ───
DEFAULT_SUPER_ADMIN_EMAIL=your-admin@example.com
DEFAULT_SUPER_ADMIN_PASSWORD=your-strong-password

# ─── Read cache (OPTIONAL but recommended — makes every portal load fast) ───
# The portals poll read endpoints (orders/products/stock/batch) and on Vercel
# every request can hit a different instance, so each one re-ran the same heavy
# queries. A shared Redis serves all instances the same warm copy.
#
# Option 1 — Upstash / Vercel KV REST (fastest to set up, no new dependency):
#   Vercel Dashboard → Storage → Create Database → Upstash Redis → connect the
#   project; Vercel then injects KV_REST_API_URL + KV_REST_API_TOKEN, or set them
#   by hand from the Upstash console.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Upstash names used when the integration is added directly from Upstash:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Option 2 — plain Redis (Redis Cloud / Railway / Render Key Value / self-hosted).
# Needs the optional `redis` package: pip install redis
# REDIS_URL=rediss://default:<password>@<host>:<port>
#
# Keys written by this app are namespaced (default "detomsite:") and invalidation
# only deletes that namespace, so a shared Redis instance is safe to reuse.
# REDIS_KEY_PREFIX=detomsite:
# REDIS_TIMEOUT_SECONDS=1.5
# REDIS_BREAKER_FAILURES=5
# REDIS_BREAKER_COOLDOWN_SECONDS=30

# ─── Optional integrations ───
# SENTRY_DSN=
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# SMTP_HOST=
# SMTP_USER=
# SMTP_PASSWORD=
# RESEND_API_KEY=